{
  "name": "video-edit",
  "productName": "Clipper",
  "version": "0.1.0",
  "description": "Нарезка стримов на клипы: фиксированные куски 20/30/60 сек или лучшие моменты по звуку",
  "main": "src/main/main.js",
  "author": "BenjaminPT",
  "license": "MIT",
  "private": true,
  "scripts": {
    "start": "electron .",
    "test": "node test/analyzer.test.js",
    "dist": "electron-builder",
    "dist:win": "electron-builder --win",
    "dist:mac": "electron-builder --mac"
  },
  "dependencies": {
    "ffmpeg-static": "^5.2.0",
    "ffprobe-static": "^3.1.0"
  },
  "devDependencies": {
    "electron": "^35.0.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.benjaminpt.clipper",
    "productName": "Clipper",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "package.json"
    ],
    "asarUnpack": [
      "node_modules/ffmpeg-static/**",
      "node_modules/ffprobe-static/**"
    ],
    "win": {
      "target": [
        { "target": "nsis", "arch": ["x64"] },
        { "target": "portable", "arch": ["x64"] }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "Clipper-Setup.${ext}"
    },
    "portable": {
      "artifactName": "Clipper-Portable.${ext}"
    },
    "mac": {
      "target": "dmg",
      "category": "public.app-category.video",
      "artifactName": "Clipper-${arch}.${ext}"
    }
  }
}
